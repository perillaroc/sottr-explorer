{
  "name": "sottr-desktop",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "contract:validate": "node scripts/contract/validate.mjs",
    "contract:document": "node scripts/contract/validate-document.mjs",
    "contract:types": "node scripts/contract/generate-types.mjs",
    "contract:images": "node scripts/contract/check-basemap-images.mjs",
    "contract:check": "node scripts/contract/validate.mjs && node scripts/contract/generate-types.mjs && vue-tsc --noEmit"
  },
  "dependencies": {
    "@lucide/vue": "^1.76.0",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "^16.0.8",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "2.6.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsdom": "30.1.3",
    "json-schema-to-typescript": "^16.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "5.1.1",
    "vue-tsc": "^3.3.14"
  },
  "pnpm": {
    "overrides": {
      "glob": "^14.0.2",
      "minimatch": "^11.0.1"
    }
  }
}
